rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /workspaces/{workspaceId}/assets/{fileId} {
      // ログイン済み（匿名認証を含む）ユーザーのみ。アップロードは1ファイル500MBまで
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.size < 500 * 1024 * 1024;
    }
  }
}
