# Firebase を使う場合のみ設定（未設定ならブラウザ内保存で動作します）
# Firebaseコンソール > プロジェクトの設定 > マイアプリ（Web）の構成値を貼り付け
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 制作データの本体も Cloud Storage に保存する場合は true（Blazeプランが必要）
VITE_FIREBASE_USE_STORAGE=false

# 会社ごとのデータ区画（任意）
VITE_WORKSPACE_ID=iroiro
